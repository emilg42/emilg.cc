---
/**
 * Start page 1b · dotted: demo 1's sections under a centered hero on the dotted
 * grid from demo 3, with a small round photo; projects as the plain list from
 * demo 2's phone layout.
 */
import { Image } from 'astro:assets';
import Page from '../start/Page.astro';
import Typed from '../start/Typed.astro';
import Icon from '../start/Icon.astro';
import About from '../start/About.astro';
import ProjectList from '../start/ProjectList.astro';
import Skills from '../start/Skills.astro';
import Contact from '../start/Contact.astro';
import photo from '../../src/assets/photo.png';
import { tagline, lead } from '../start/content.js';
---

<Page version="1b">
  <section class="hero">
    <div class="wrap center">
      <figure class="avatar" data-reveal>
        <Image src={photo} alt="Portrait of Emil" widths={[128, 256]} sizes="128px" loading="eager" />
      </figure>
      <p class="prompt" data-reveal style="--d: 0.06s"><span>~ $</span> whoami</p>
      <h1 data-reveal style="--d: 0.1s">Hi, I'm Emil.<Typed lines={[tagline]} gradient class="line" /></h1>
      <p class="lead" data-reveal style="--d: 0.16s">{lead}</p>
      <div class="buttons" data-reveal style="--d: 0.22s">
        <a class="btn solid" href="#projects">View my work <Icon name="arrow-right" /></a>
        <a class="btn ghost" href="#contact">Get in touch</a>
      </div>
    </div>
  </section>

  <About />
  <ProjectList />
  <Skills />
  <Contact />
</Page>

<style>
  .hero {
    --dot: rgb(136 146 176 / 0.24);
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100vh;
    padding: calc(var(--header-h) + 40px) 0 80px;
    overflow: hidden;
  }

  :global([data-theme='light']) .hero {
    --dot: rgb(54 53 55 / 0.16);
  }

  /* dotted grid that fades out around the center */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--dot) 1px, transparent 1.5px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse 55% 50% at 50% 45%, black 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 55% 50% at 50% 45%, black 20%, transparent 75%);
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(520px circle at 50% 38%, rgb(65 160 174 / 0.1), transparent 70%);
    pointer-events: none;
  }

  .center {
    position: relative;
    z-index: 1;
    width: 100%;
    text-align: center;
  }

  /* small round photo: a hairline ring with a little air around the picture */
  .avatar {
    width: 128px;
    height: 128px;
    margin: 0 auto 30px;
    padding: 5px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--secondary-bg-color);
    box-shadow: 0 0 60px -12px rgb(65 160 174 / 0.4);
    transition: transform 0.5s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .avatar:hover {
    transform: scale(1.04);
  }

  .avatar :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .prompt {
    margin-bottom: 18px;
    font: 15px var(--font-mono);
    color: var(--muted);
  }

  .prompt span {
    color: var(--blend-2-theme-color);
  }

  h1 {
    font-size: clamp(44px, 6.6vw, 92px);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  /* one line at every width, centered as a whole but typed from its left end */
  h1 :global(.line) {
    width: fit-content;
    margin: 10px auto 0;
    font-size: min(0.62em, 7.4vw);
    letter-spacing: -0.03em;
    white-space: nowrap;
    text-align: left;
  }

  .lead {
    max-width: 30em;
    margin: 26px auto 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: balance;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 38px;
  }

  .buttons .btn {
    padding-inline: 24px;
    border-radius: 999px;
  }

  /* both buttons side by side on phones too */
  @media (max-width: 420px) {
    .buttons {
      gap: 10px;
    }

    .buttons .btn {
      padding-inline: 18px;
    }
  }
</style>
