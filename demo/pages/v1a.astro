---
/**
 * Start page 1a · refined: demo 1 with calmer details — solid and outline
 * buttons, the photo on a field of dots (Portrait.astro; how the dots react
 * on hover is picked in the switcher), and small 01 / 04 counters on the projects.
 */
import Page from '../start/Page.astro';
import Typed from '../start/Typed.astro';
import Icon from '../start/Icon.astro';
import Portrait from '../start/Portrait.astro';
import About from '../start/About.astro';
import ProjectRows from '../start/ProjectRows.astro';
import Skills from '../start/Skills.astro';
import Contact from '../start/Contact.astro';
import { tagline, lead, dotHovers } from '../start/content.js';
---

<Page version="1a" hovers={dotHovers}>
  <section class="hero">
    <div class="wrap grid">
      <div class="intro">
        <p class="prompt" data-reveal><span>~ $</span> whoami</p>
        <h1 data-reveal style="--d: 0.08s">Hi, I'm Emil.<Typed lines={[tagline]} gradient class="line" /></h1>
        <p class="lead" data-reveal style="--d: 0.16s">{lead}</p>
        <div class="buttons" data-reveal style="--d: 0.24s">
          <a class="btn solid" href="#projects">View my work <Icon name="arrow-right" /></a>
          <a class="btn ghost" href="#contact">Get in touch</a>
        </div>
      </div>
      <div class="photo" data-reveal style="--d: 0.2s">
        <Portrait />
      </div>
    </div>
  </section>

  <About />
  <ProjectRows numbers="counter" />
  <Skills />
  <Contact />
</Page>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100vh;
    padding: calc(var(--header-h) + 40px) 0 80px;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(480px circle at 12% 85%, rgb(54 102 156 / 0.08), transparent 65%);
    pointer-events: none;
  }

  .grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 72px;
  }

  .prompt {
    margin-bottom: 22px;
    font: 15px var(--font-mono);
    color: var(--muted);
  }

  .prompt span {
    color: var(--blend-2-theme-color);
  }

  h1 {
    font-size: clamp(40px, 5.4vw, 74px);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  h1 :global(.line) {
    margin-top: 6px;
    font-size: 0.72em;
    letter-spacing: -0.03em;
  }

  .lead {
    max-width: 30em;
    margin-top: 26px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: balance;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  @media (max-width: 900px) {
    /* room for the dots below the photo */
    .grid {
      grid-template-columns: 1fr;
      gap: 64px;
    }

    .photo {
      order: -1;
    }
  }
</style>
