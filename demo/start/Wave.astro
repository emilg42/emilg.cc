---
/**
 * Wave edge of a section (top or bottom), painted in the page background so
 * a section's own background appears to flow in and out.
 */
const { pos = 'top' } = Astro.props;
---

<div class:list={['wave', pos]} aria-hidden="true">
  <svg viewBox="0 0 1200 120" preserveAspectRatio="none">
    <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"></path>
  </svg>
</div>

<style>
  .wave {
    position: absolute;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    pointer-events: none;
  }

  .top {
    top: 0;
  }

  .bottom {
    bottom: 0;
    transform: rotate(180deg);
  }

  svg {
    display: block;
    width: calc(115% + 1.3px);
    height: 60px;
  }

  path {
    fill: var(--secondary-bg-color);
  }
</style>
