---
/**
 * The hero photo on a field of dots that fades out around it. Hovering the
 * photo lifts only the photo; `hover` picks what the dots do (demo, switchable
 * live):
 *   still   nothing
 *   drift   the dots lean a few pixels away from the pointer, like a layer behind
 *   ripple  one soft wave runs out through the dots, nudging and lighting them
 *   repel   dots near the pointer slide out of its way and spring back
 *   soft    the ripple at half the height, fainter and slower
 * The dots are a CSS pattern; with JavaScript (and motion allowed) a canvas
 * draws the same pattern and moves it, only while something happens.
 */
import { Image } from 'astro:assets';
import photo from '../../src/assets/photo.png';

const { hover = 'still' } = Astro.props;
---

<figure class="portrait" data-hover={hover}>
  <span class="glow" aria-hidden="true"></span>
  <span class="field" aria-hidden="true"></span>
  <canvas class="dots" aria-hidden="true"></canvas>
  <span class="frame">
    <Image
      src={photo}
      alt="Portrait of Emil"
      widths={[320, 640, 960]}
      sizes="(max-width: 900px) 280px, 320px"
      quality={90}
      loading="eager"
    />
  </span>
</figure>

<script>
  const STEP = 20; // grid, as in the CSS pattern
  const DOT = 1.35; // dot radius
  const SPREAD = 1.68; // the field is 168% of the photo (inset: -34%)
  const CORNER = 20; // the photo's corner radius
  const LIGHT = 'rgb(65 160 174)';
  // the ripples: how far the wave nudges the dots (px), how much it lights them, how long it runs
  const RIPPLES = { ripple: { push: 3, light: 0.7, ms: 1800 }, soft: { push: 1.5, light: 0.3, ms: 2600 } };

  const setup = (portrait) => {
    const canvas = portrait.querySelector('.dots');
    const frame = portrait.querySelector('.frame');
    const ctx = canvas.getContext('2d');
    const mode = () => portrait.dataset.hover;

    let dots = [];
    let size = 0;
    let dpr = 1;
    let color = '';
    let frameId = 0;

    let over = false; // pointer over the photo
    let lean = { x: 0, y: 0 }; // where on the photo, -1…1
    let pointer = null; // pointer over the field, canvas px (repel)
    let wave = 0; // when the ripple started
    const shift = { x: 0, y: 0 }; // drift, px

    // dots of the pattern that can show: not deep behind the photo, not faded out
    const layout = () => {
      size = canvas.clientWidth;
      dpr = devicePixelRatio || 1;
      canvas.width = canvas.height = Math.round(size * dpr);
      const c = size / 2;
      const inner = size / SPREAD / 2 - CORNER;
      const n = Math.floor(c / STEP);
      dots = [];
      for (let j = -n; j <= n; j++) {
        for (let i = -n; i <= n; i++) {
          const x = i * STEP;
          const y = j * STEP;
          const r = Math.hypot(x, y) / c;
          const fade = r <= 0.5 ? 1 : Math.max(0, (1 - r) * 2); // the CSS mask
          // distance to the photo's rounded outline, and the way out of it
          const qx = Math.sign(x) * Math.max(Math.abs(x) - inner, 0);
          const qy = Math.sign(y) * Math.max(Math.abs(y) - inner, 0);
          const out = Math.hypot(qx, qy);
          const edge = out - CORNER;
          if (fade > 0 && edge > -8) dots.push({ x: c + x, y: c + y, fade, edge, nx: qx / out, ny: qy / out, dx: 0, dy: 0, glow: 0 });
        }
      }
      color = getComputedStyle(portrait).getPropertyValue('--dot').trim();
      draw();
    };

    const draw = () => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, size, size);
      ctx.fillStyle = color;
      for (const d of dots) {
        ctx.globalAlpha = d.fade;
        ctx.beginPath();
        ctx.arc(d.x + d.dx + shift.x, d.y + d.dy + shift.y, DOT, 0, 2 * Math.PI);
        ctx.fill();
      }
      ctx.fillStyle = LIGHT;
      for (const d of dots) {
        if (d.glow < 0.01) continue;
        ctx.globalAlpha = d.fade * d.glow;
        ctx.beginPath();
        ctx.arc(d.x + d.dx + shift.x, d.y + d.dy + shift.y, DOT + 0.25, 0, 2 * Math.PI);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    // one frame; keeps going while anything still moves
    const step = (now) => {
      frameId = 0;
      let busy = false;
      const ease = (value, target, rate) => {
        const next = value + (target - value) * rate;
        if (Math.abs(target - next) > 0.02) busy = true;
        return Math.abs(target - next) > 0.02 ? next : target;
      };

      // drift: the whole pattern leans away from the pointer, 5px at most
      const drift = mode() === 'drift' && over;
      shift.x = ease(shift.x, drift ? -lean.x * 5 : 0, 0.08);
      shift.y = ease(shift.y, drift ? -lean.y * 5 : 0, 0.08);

      // ripple: a wave from the photo's edge outwards
      const ripple = RIPPLES[mode()];
      const t = wave && ripple ? (now - wave) / ripple.ms : 1;
      const front = Math.min(t, 1) * 130 - 10;
      const rate = ripple ? 1 : 0.14;
      if (t < 1) busy = true;
      else wave = 0;

      for (const d of dots) {
        let x = 0;
        let y = 0;
        d.glow = 0;
        if (ripple && t < 1) {
          const g = Math.exp(-(((d.edge - front) / 16) ** 2));
          x = d.nx * ripple.push * g;
          y = d.ny * ripple.push * g;
          d.glow = g * (1 - t) * ripple.light;
        }
        // repel: pushed out of an 90px circle around the pointer, 6px at most
        if (mode() === 'repel' && pointer) {
          const px = d.x - pointer.x;
          const py = d.y - pointer.y;
          const dist = Math.hypot(px, py);
          if (dist > 0 && dist < 90) {
            const push = 6 * (1 - dist / 90) ** 2;
            x = (px / dist) * push;
            y = (py / dist) * push;
          }
        }
        d.dx = ease(d.dx, x, rate);
        d.dy = ease(d.dy, y, rate);
      }

      draw();
      if (busy) frameId = requestAnimationFrame(step);
    };
    const kick = () => frameId || (frameId = requestAnimationFrame(step));

    frame.addEventListener('pointerenter', () => {
      over = true;
      if (RIPPLES[mode()]) wave = performance.now();
      kick();
    });
    frame.addEventListener('pointermove', (event) => {
      const box = frame.getBoundingClientRect();
      lean = { x: ((event.clientX - box.left) / box.width) * 2 - 1, y: ((event.clientY - box.top) / box.height) * 2 - 1 };
      kick();
    });
    frame.addEventListener('pointerleave', () => {
      over = false;
      kick();
    });

    // repel follows the pointer over the whole field, not just the photo
    const follow = (event) => {
      if (mode() !== 'repel' && !pointer) return;
      const box = canvas.getBoundingClientRect();
      const inside = event && event.clientX > box.left && event.clientX < box.right && event.clientY > box.top && event.clientY < box.bottom;
      if (!inside && !pointer) return;
      pointer = inside && mode() === 'repel' ? { x: event.clientX - box.left, y: event.clientY - box.top } : null;
      kick();
    };
    addEventListener('pointermove', follow, { passive: true });
    document.documentElement.addEventListener('pointerleave', () => follow(null));

    // switched in the demo: settle back to rest
    new MutationObserver(() => {
      wave = 0;
      follow(null);
      kick();
    }).observe(portrait, { attributes: true, attributeFilter: ['data-hover'] });

    // theme changed: redraw in the other dot color
    new MutationObserver(() => {
      color = getComputedStyle(portrait).getPropertyValue('--dot').trim();
      draw();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    new ResizeObserver(layout).observe(canvas);
  };

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.portrait').forEach((portrait) => {
      portrait.classList.add('live');
      setup(portrait);
    });
  }
</script>

<style>
  .portrait {
    --ring: rgb(136 146 176 / 0.18);
    --dot: rgb(136 146 176 / 0.36);
    --shadow: 0 30px 60px -28px rgb(0 0 0 / 0.6);
    --shadow-up: 0 38px 64px -30px rgb(0 0 0 / 0.65);
    position: relative;
    isolation: isolate;
    width: min(320px, 28vw);
    margin: 0;
  }

  :global([data-theme='light']) .portrait {
    --ring: rgb(54 53 55 / 0.12);
    --dot: rgb(54 53 55 / 0.3);
    --shadow: 0 30px 60px -30px rgb(0 0 0 / 0.35);
    --shadow-up: 0 38px 64px -32px rgb(0 0 0 / 0.4);
  }

  /* only the photo lifts, the dots stay */
  .frame {
    position: relative;
    display: block;
    border-radius: 20px;
    box-shadow: var(--shadow);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.45s;
  }

  .portrait:hover .frame {
    box-shadow: var(--shadow-up);
    transform: translateY(-4px);
  }

  /* hairline over the photo's edge */
  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--ring);
    pointer-events: none;
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: inherit;
  }

  /* behind the photo: a little light, and the dots */
  .glow,
  .field,
  .dots {
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  .glow {
    inset: -25%;
    background: radial-gradient(closest-side, rgb(65 160 174 / 0.1), transparent);
  }

  .field {
    inset: -34%;
    background-image: radial-gradient(var(--dot) 1.2px, transparent 1.7px);
    background-position: center;
    background-size: 20px 20px;
    mask-image: radial-gradient(closest-side, black 50%, transparent);
    -webkit-mask-image: radial-gradient(closest-side, black 50%, transparent);
  }

  .dots {
    top: -34%;
    left: -34%;
    display: none;
    width: 168%;
    height: 168%;
  }

  .live .dots {
    display: block;
  }

  .live .field {
    display: none;
  }

  @media (max-width: 900px) {
    .portrait {
      width: min(280px, 72vw);
    }
  }
</style>
