---
/**
 * Contact section from demo 1 ("Let's talk."), without the extra button:
 * one card with mail and GitHub.
 */
import Icon from './Icon.astro';
import { contact, links } from './content.js';
---

<section id="contact" class="section">
  <div class="wrap center" data-reveal>
    <p class="eyebrow">04 · contact</p>
    <h2>Let's talk.</h2>
    <p class="text">{contact}</p>
    <div class="card">
      <a href={`mailto:${links.mail}`}>
        <span class="tile"><Icon name="mail" /></span>
        <span><small>Email</small>{links.mail}</span>
        <Icon name="arrow-up-right" />
      </a>
      <a href={links.github}>
        <span class="tile"><Icon name="github" /></span>
        <span><small>GitHub</small>emilg42</span>
        <Icon name="arrow-up-right" />
      </a>
    </div>
  </div>
</section>

<style>
  .center {
    max-width: 640px;
    text-align: center;
  }

  h2 {
    font-size: clamp(34px, 4vw, 50px);
  }

  .text {
    max-width: 34em;
    margin: 20px auto 0;
    font-size: 18px;
    line-height: 1.65;
    color: var(--muted);
  }

  .card {
    display: grid;
    margin-top: 44px;
    text-align: left;
  }

  a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    color: var(--primary-text-color);
    text-decoration: none;
    transition: background 0.2s;
  }

  a + a {
    border-top: 1px solid var(--line);
  }

  a:hover {
    background: rgb(65 160 174 / 0.06);
  }

  .tile {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    color: var(--blend-3-theme-color);
    background: rgb(65 160 174 / 0.12);
  }

  small {
    display: block;
    font: 12px var(--font-mono);
    color: var(--muted);
  }
</style>
