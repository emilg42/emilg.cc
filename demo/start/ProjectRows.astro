---
/**
 * Projects from demo 1: alternating rows of drawing and text.
 *   numbers: "counter" shows a small 01 / 04 above the text,
 *            "label" puts a teal 01. in front of the name
 */
import Art from './Art.astro';
import Icon from './Icon.astro';
import { projects, links } from './content.js';

const { numbers = 'counter' } = Astro.props;
const pad = (n) => String(n).padStart(2, '0');
---

<section id="projects" class="section">
  <div class="wrap">
    <div class="heading" data-reveal>
      <p class="eyebrow">02 · projects</p>
      <h2>Things I've built</h2>
    </div>
    {projects.map((project, i) => (
      <article class:list={['project', { flip: i % 2 }]} data-reveal>
        <a class="shot card" href={project.url} aria-label={`${project.name} on GitHub`}>
          <Art kind={project.art} />
        </a>
        <div class="info">
          {numbers === 'counter' && (
            <p class="counter">
              <span>{pad(i + 1)}</span> / {pad(projects.length)}
            </p>
          )}
          <h3>
            <a href={project.url}>
              {numbers === 'label' && <span class="label">{pad(i + 1)}.</span>}
              {project.name}
            </a>
          </h3>
          <p class="meta">
            {project.lang} · <Icon name="star" size={13} /> {project.stars}
          </p>
          <p class="text">{project.text}</p>
          <ul class="tags">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
        </div>
      </article>
    ))}
    <p class="more" data-reveal>
      <a href={links.github}>More on GitHub <Icon name="arrow-right" size={16} /></a>
    </p>
  </div>
</section>

<style>
  .heading {
    margin-bottom: 64px;
    text-align: center;
  }

  h2 {
    font-size: clamp(34px, 4vw, 50px);
  }

  .project {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: 56px;
    margin-bottom: 96px;
  }

  .project.flip .shot {
    order: 2;
  }

  .shot {
    display: block;
    overflow: hidden;
    transition:
      transform 0.4s cubic-bezier(0.34, 1.4, 0.64, 1),
      box-shadow 0.3s,
      border-color 0.3s;
  }

  /* lift with a soft shadow and a hint of teal on the edge, no colored glow */
  .shot:hover {
    transform: translateY(-4px);
    border-color: rgb(65 160 174 / 0.3);
    box-shadow: 0 24px 48px -32px rgb(0 0 0 / 0.6);
  }

  /* 01 / 04 */
  .counter {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    font: 13px var(--font-mono);
    color: var(--muted);
  }

  .counter span {
    color: var(--blend-3-theme-color);
  }

  .counter::after {
    content: '';
    width: 40px;
    height: 1px;
    margin-left: 8px;
    background: var(--line);
  }

  /* 01. */
  .label {
    margin-right: 12px;
    font: 400 0.55em var(--font-mono);
    letter-spacing: 0;
    color: var(--blend-3-theme-color);
    vertical-align: 0.25em;
  }

  h3 {
    font-size: 34px;
  }

  h3 a {
    color: inherit;
    text-decoration: none;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    font: 13px var(--font-mono);
    color: var(--muted);
  }

  .text {
    margin: 14px 0 22px;
    font-size: 18px;
    line-height: 1.65;
    color: var(--muted);
  }

  .more {
    text-align: center;
  }

  .more a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 600 16px var(--font-display);
    color: var(--blend-3-theme-color);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .project {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-bottom: 72px;
    }

    .project.flip .shot {
      order: 0;
    }
  }
</style>
