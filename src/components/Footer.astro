---
/**
 * Simple Footer displaying versioning, links and legal notice.
 */
import BranchIcon from '../assets/icons/branch.svg';
---

<a class="link" href="https://github.com/emilg42/emilg.cc" target="_blank" data-umami-event="source-click">
  <footer class="container">
    <p>designed and built by emilg</p>
    <p>{new Date().getFullYear()} &gt; source <BranchIcon /></p>
  </footer>
</a>

<style>
  .link {
    text-decoration: none;
  }

  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 20px 0 15px;
    line-height: 20px;
    font-size: 14px;
    font-family: 'SFMono';
    color: var(--primary-border-color);
    transition: 0.3s ease-in;
  }

  .container :global(svg) {
    transform: translateY(3px);
  }

  .container:hover {
    cursor: pointer;
    color: var(--blend-3-theme-color);
  }
</style>
