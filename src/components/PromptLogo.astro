---
/**
 * Alternative header logo (not in use, see NavigationBar): the mark with the
 * same faint halo as Logo, and "~/emilg.cc" in SF Mono with a cursor like the
 * About typewriter. Hover deletes and retypes the name while the mark leans
 * back slightly. The cursor blinks four times, then fades away.
 */
import Mark from '../assets/icons/mark.svg';
---

<a class="logo idle" href="/" aria-label="emilg.cc" data-logo="prompt" data-umami-event="logo-click">
  <span class="badge">
    <span class="halo"></span>
    <span class="motion"><Mark /></span>
  </span>
  <span class="word"><span class="prompt">~/</span><span class="text">emilg.cc</span><span class="cursor">▌</span></span>
</a>

<script>
  const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

  // delete and retype the name on hover, then let the cursor blink again
  document.querySelectorAll('[data-logo="prompt"]').forEach((logo) => {
    const text = logo.querySelector('.text');
    const name = text.textContent;
    let busy = false;

    logo.addEventListener('mouseenter', async () => {
      if (busy) return;
      busy = true;
      logo.classList.remove('idle');
      logo.classList.add('deleting');
      for (let i = name.length - 1; i >= 0; i--) {
        await sleep(35);
        text.textContent = name.slice(0, i);
      }
      await sleep(250);
      logo.classList.remove('deleting');
      for (let i = 1; i <= name.length; i++) {
        await sleep(75);
        text.textContent = name.slice(0, i);
      }
      void logo.offsetWidth;
      logo.classList.add('idle');
      busy = false;
    });
  });
</script>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
  }

  .badge {
    position: relative;
    display: grid;
  }

  /* a gradient, not a CSS filter on the svg (Safari clips those to a box) */
  .halo {
    position: absolute;
    inset: -12px -14px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(62 201 149 / 0.09), rgb(62 201 149 / 0));
  }

  .motion {
    display: grid;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.25));
    transition: transform 0.4s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .deleting .motion {
    transform: rotate(-5deg);
  }

  .motion :global(svg) {
    height: 34px;
    width: auto;
  }

  /* x-height centered on the mark */
  .word {
    position: relative;
    top: -0.089em;
    font-family: 'SFMono';
    font-size: 19px;
    line-height: 1;
    white-space: pre;
    color: var(--primary-text-color);
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.25);
  }

  .prompt {
    color: var(--primary-border-color);
  }

  .cursor {
    margin-left: 0.2em;
    color: var(--blend-2-theme-color);
  }

  /* blink four times, then fade away */
  .idle .cursor {
    animation:
      blink 1s steps(1) 4,
      caret-out 0.6s ease 4s forwards;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes caret-out {
    to {
      opacity: 0;
    }
  }

  :global([data-theme='light']) .motion {
    filter: drop-shadow(0 1px 2px rgb(54 53 55 / 0.12));
  }

  :global([data-theme='light']) .word {
    text-shadow: 0 1px 3px rgb(54 53 55 / 0.12);
  }
</style>
