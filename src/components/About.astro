---
/**
 * About: a short statement and four highlight tiles, in a band with wave
 * edges.
 */
import Wave from './Wave.astro';
import Icon from './Icon.astro';
import { about, highlights } from '../content.js';
---

<section id="about" class="section band">
  <Wave pos="top" />
  <Wave pos="bottom" />
  <div class="wrap about">
    <div data-reveal>
      <p class="eyebrow">01 · about</p>
      <h2>Small tools,<br /><span class="gradient">real-world software.</span></h2>
      <p class="text">{about}</p>
    </div>
    <ul class="highlights">
      {highlights.map((item, i) => (
        <li class="card" data-reveal style={`--d: ${i * 0.06}s`}>
          <span class="tile"><Icon name={item.icon} /></span>
          <strong>{item.title}</strong>
          <span>{item.text}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 64px;
  }

  h2 {
    font-size: clamp(34px, 4vw, 50px);
  }

  .text {
    max-width: 34em;
    margin-top: 20px;
    font-size: 18px;
    line-height: 1.65;
    color: var(--muted);
  }

  .highlights {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    list-style: none;
  }

  .highlights li {
    display: grid;
    gap: 4px;
    padding: 22px;
  }

  .tile {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 12px;
    border-radius: 12px;
    color: var(--blend-3-theme-color);
    background: rgb(65 160 174 / 0.12);
  }

  strong {
    font: 600 17px var(--font-display);
  }

  li span:last-child {
    font-size: 14.5px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 520px) {
    .highlights {
      grid-template-columns: 1fr;
    }
  }
</style>
