---
/**
 * Small drawings for projects that have no screenshots, in the site's colors:
 *   events: what an event camera sees (mvu)   menu: a keyboard launcher (dmenu)
 *   tiles:  a tiling window manager (dwm)     pong: a game of pong (cpong)
 */
const { kind } = Astro.props;

// seeded random numbers, so every build draws the same picture
let seed = 7;
const random = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

// events: a moving object leaves a trail of "on" (green) and "off" (blue) events
const events = [];
if (kind === 'events') {
  for (let i = 0; i < 260; i++) {
    const age = i / 260; // 0 = oldest, 1 = newest
    const a = Math.PI * 2 * (0.12 + age * 0.88);
    const spread = 20 * (1 - age * 0.6);
    events.push({
      x: 200 + 132 * Math.sin(a) + (random() - 0.5) * spread,
      y: 122 + 64 * Math.sin(2 * a) + (random() - 0.5) * spread,
      on: random() > 0.42,
      opacity: 0.12 + 0.88 * age * age,
      r: 1.4 + random() * 1.5,
      twinkle: random() < 0.22,
      delay: (random() * 2.4).toFixed(2),
    });
  }
  // sensor noise
  for (let i = 0; i < 80; i++) {
    events.push({ x: random() * 400, y: random() * 250, on: random() > 0.5, opacity: 0.1 + random() * 0.18, r: 1.2 });
  }
}

const launcher = ['firefox', 'fish', 'find', 'fio', 'file-roller', 'firewall-cmd'];
---

<svg class:list={['art', kind]} viewBox="0 0 400 250" aria-hidden="true">
  <rect width="400" height="250" fill="#16171c"></rect>

  {
    kind === 'events' && (
      <g>
        <g fill="#8892b0" opacity="0.07">
          {Array.from({ length: 20 }, (_, col) => Array.from({ length: 12 }, (_, row) => <rect x={col * 20 + 9} y={row * 20 + 9} width="2" height="2" />))}
        </g>
        {events.map((e) => (
          <circle
            cx={e.x.toFixed(1)}
            cy={e.y.toFixed(1)}
            r={e.r.toFixed(1)}
            fill={e.on ? '#3ec995' : '#36669c'}
            opacity={e.opacity.toFixed(2)}
            class:list={{ twinkle: e.twinkle }}
            style={e.twinkle ? `animation-delay: ${e.delay}s` : undefined}
          />
        ))}
        <circle cx="200" cy="122" r="16" fill="#8fcb76" opacity="0.18" />
        <g class="label">
          <circle cx="306" cy="230" r="3" fill="#3ec995" />
          <text x="314" y="233">on</text>
          <circle cx="342" cy="230" r="3" fill="#36669c" />
          <text x="350" y="233">off</text>
        </g>
      </g>
    )
  }

  {
    kind === 'menu' && (
      <g>
        <rect width="400" height="250" fill="url(#menu-wall)" />
        <defs>
          <radialGradient id="menu-wall" cx="70%" cy="80%" r="70%">
            <stop offset="0" stop-color="#3ec995" stop-opacity="0.16" />
            <stop offset="1" stop-color="#16171c" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect width="400" height="26" fill="#121214" />
        <rect width="46" height="26" fill="#41a0ae" />
        <text x="23" y="17" text-anchor="middle" class="dark">run</text>
        <text x="56" y="17" class="light">fi</text>
        <rect x="70" y="7" width="2" height="13" fill="#8fcb76" class="blink" />
        <rect y="26" width="400" height="148" fill="#1a1b21" />
        {launcher.map((item, i) => (
          <g>
            {i === 0 && <rect y={26 + i * 24} width="400" height="24" fill="#41a0ae" />}
            <text x="14" y={42 + i * 24} class={i === 0 ? 'dark' : 'muted'}>
              <tspan class={i === 0 ? 'dark' : 'match'}>fi</tspan>
              {item.slice(2)}
            </text>
          </g>
        ))}
      </g>
    )
  }

  {
    kind === 'tiles' && (
      <g>
        <rect width="400" height="20" fill="#121214" />
        {Array.from({ length: 9 }, (_, i) => (
          <g>
            <rect x={5 + i * 17} y="3" width="14" height="14" rx="3" fill={i === 0 ? '#41a0ae' : 'none'} />
            <text x={12 + i * 17} y="14" text-anchor="middle" class={i === 0 ? 'dark tiny' : 'muted tiny'}>
              {i + 1}
            </text>
          </g>
        ))}
        <text x="394" y="14" text-anchor="end" class="muted tiny">dwm</text>
        <rect x="8" y="28" width="230" height="214" rx="6" fill="#1d1e25" stroke="#41a0ae" stroke-width="2" />
        <text x="20" y="50" class="match">~ $ <tspan class="light">make install</tspan></text>
        {[150, 120, 176, 90, 140, 64].map((w, i) => (
          <rect x="20" y={64 + i * 16} width={w} height="6" rx="3" fill="#8892b0" opacity="0.28" />
        ))}
        <text x="20" y="176" class="match">~ $ <tspan class="light">▌</tspan></text>
        {[28, 102, 176].map((y, i) => (
          <g>
            <rect x="246" y={y} width="146" height="66" rx="6" fill="#1d1e25" stroke="#3a3d4a" stroke-width="1.5" />
            {i === 0 && <polyline points={`256,${y + 52} 280,${y + 34} 300,${y + 42} 324,${y + 18} 348,${y + 30} 380,${y + 14}`} fill="none" stroke="#3ec995" stroke-width="2" />}
            {i === 1 && [96, 70, 110].map((w, j) => <rect x="256" y={y + 14 + j * 14} width={w} height="6" rx="3" fill="#8892b0" opacity="0.25" />)}
            {i === 2 && <circle cx="319" cy={y + 33} r="18" fill="none" stroke="#36669c" stroke-width="6" stroke-dasharray="70 120" />}
          </g>
        ))}
      </g>
    )
  }

  {
    kind === 'pong' && (
      <g>
        <line x1="200" y1="12" x2="200" y2="238" stroke="#3a3d4a" stroke-width="3" stroke-dasharray="10 10" />
        <text x="172" y="54" text-anchor="middle" class="score">3</text>
        <text x="228" y="54" text-anchor="middle" class="score">2</text>
        <rect x="22" y="84" width="8" height="58" rx="3" fill="#41a0ae" />
        <rect x="370" y="122" width="8" height="58" rx="3" fill="#8fcb76" />
        <circle cx="190" cy="150" r="3" fill="#f5f6ef" opacity="0.1" />
        <circle cx="214" cy="138" r="4" fill="#f5f6ef" opacity="0.2" />
        <circle cx="238" cy="126" r="5" fill="#f5f6ef" opacity="0.4" />
        <circle cx="262" cy="114" r="6.5" fill="#f5f6ef" class="ball" />
      </g>
    )
  }
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    height: auto;
  }

  text {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    fill: #8892b0;
  }

  .tiny {
    font-size: 9px;
  }

  .dark {
    fill: #0f1a17;
    font-weight: 700;
  }

  .light {
    fill: #f5f6ef;
  }

  .muted {
    fill: #8892b0;
  }

  .match {
    fill: #3ec995;
  }

  .score {
    font-size: 30px;
    fill: #3a3d4a;
  }

  .label text {
    font-size: 10px;
  }

  .twinkle {
    animation: twinkle 2.4s ease-in-out infinite;
  }

  .blink {
    animation: blink 1s steps(1) infinite;
  }

  @keyframes twinkle {
    50% {
      opacity: 0.1;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .twinkle,
    .blink {
      animation: none;
    }
  }
</style>
