---
/**
 * Skills: a grid of short cards, in a band with wave edges.
 */
import Wave from './Wave.astro';
import { skills } from '../content.js';
---

<section id="skills" class="section band">
  <Wave pos="top" />
  <Wave pos="bottom" />
  <div class="wrap">
    <div class="heading" data-reveal>
      <p class="eyebrow">03 · skills</p>
      <h2>Tools I use</h2>
    </div>
    <ul class="skills">
      {skills.map((skill, i) => (
        <li class="card" data-reveal style={`--d: ${(i % 4) * 0.05}s`}>
          <strong>{skill.name}</strong>
          <span>{skill.note}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .heading {
    margin-bottom: 56px;
  }

  h2 {
    font-size: clamp(34px, 4vw, 50px);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    list-style: none;
  }

  li {
    display: grid;
    gap: 4px;
    padding: 22px 24px;
  }

  strong {
    font: 600 17px var(--font-display);
  }

  span {
    font-size: 14.5px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .skills {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
