---
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

    {/* icons */}
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <link rel="mask-icon" href="/favicons/safari-pinned-tab.svg" color="#5bbad5" />
    <link rel="shortcut icon" href="/favicons/favicon.ico" />
    <meta name="msapplication-TileColor" content="#2b5797" />
    <meta name="msapplication-config" content="/favicons/browserconfig.xml" />
    <meta name="theme-color" content="#ffffff" />

    {/* open graph ... */}

    {/* lets styles wait for scripts (fade-ins, typing) only when scripts run */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {/* visitor stats: Umami (cookieless, no banner), built site on emilg.cc only */}
    {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id="7a841f0c-eda8-4a11-95c1-84ab6d0eded0"
        data-domains="emilg.cc"
      ></script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // fade [data-reveal] elements in as they scroll into view
  const reveal = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('in');
        reveal.unobserve(entry.target);
      }),
    { rootMargin: '0px 0px -8% 0px' },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => reveal.observe(el));
</script>

<style is:global>
  /* dark theme (default) */
  :root {
    /* theme colors */
    --primary-theme-color: #324f8c;

    --blend-1-theme-color: #3a2f6b;
    --blend-2-theme-color: #36669c;
    --blend-3-theme-color: #41a0ae;
    --blend-4-theme-color: #3ec995;
    --blend-5-theme-color: #77f07f;

    /* typography colors */
    --primary-text-color: #f5f6ef;

    /* background colors */
    --primary-bg-color: #23252f;
    --secondary-bg-color: #1d1e25;
    --tertiary-bg-color: #121214;

    /* border colors */
    --primary-border-color: #8892b0;

    /* type */
    --font-display: 'Space Grotesk', system-ui, sans-serif;
    --font-body: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --font-mono: 'SFMono', ui-monospace, Menlo, monospace;

    /* surfaces */
    --header-h: 72px;
    --header-bg: rgb(29 30 37 / 0.78);
    --line: rgb(136 146 176 / 0.16);
    --card: rgb(255 255 255 / 0.03);
    --muted: color-mix(in srgb, var(--primary-text-color) 66%, var(--secondary-bg-color));
    --gradient: linear-gradient(90deg, #3d8fb0, #41a7a8 35%, #46bb93 65%, #8fcb76);
  }

  /* light theme, toggled via <html data-theme="light"> */
  :root[data-theme='light'] {
    --primary-text-color: #363537;

    --primary-bg-color: #ffffff;
    --secondary-bg-color: #f2eded;
    --tertiary-bg-color: #ccc8c8;

    --header-bg: rgb(242 237 237 / 0.82);
    --line: rgb(54 53 55 / 0.1);
    --card: rgb(255 255 255 / 0.75);
  }

  /* globally used fonts ~ served as static assets */
  @font-face {
    font-family: 'Space Grotesk';
    src: url('/fonts/SpaceGrotesk.woff2') format('woff2');
    font-weight: 300 700;
    font-display: swap;
  }

  @font-face {
    font-family: Ubuntu;
    src: url('/fonts/Ubuntu.ttf');
  }

  @font-face {
    font-family: SFMono;
    src: url('/fonts/SFMono.otf');
  }

  @font-face {
    font-family: Cantarell;
    src: url('/fonts/Cantarell.ttf');
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    outline: none;
  }

  html {
    font-size: 100%;
    max-width: 100%;
    overflow-x: hidden;
    scroll-behavior: smooth;
    scroll-padding-top: calc(var(--header-h) + 12px);
    scrollbar-width: thin;
    scrollbar-color: rgb(136 146 176 / 0.35) transparent;
  }

  body {
    font-family: var(--font-body);
    color: var(--primary-text-color);
    background: var(--secondary-bg-color);
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  ::selection {
    background: rgb(65 160 174 / 0.35);
  }

  /* building blocks */
  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 clamp(24px, 7vw, 96px);
    box-sizing: content-box;
  }

  .section {
    position: relative;
    padding: 120px 0;
  }

  /* a section in the lighter background, between two waves */
  .band {
    padding: 160px 0;
    background: var(--primary-bg-color);
  }

  .eyebrow {
    margin-bottom: 14px;
    font: 13px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--blend-3-theme-color);
  }

  .gradient {
    color: transparent;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .caret {
    display: inline-block;
    width: 0.07em;
    height: 0.82em;
    margin-left: 0.06em;
    vertical-align: -0.04em;
    border-radius: 2px;
    background: #8fcb76;
    animation: caret 1s steps(1) infinite;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  /* buttons: solid in the text color, or an outline */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 22px;
    border: 1px solid var(--line);
    border-radius: 12px;
    font: 600 16px var(--font-display);
    color: var(--primary-text-color);
    text-decoration: none;
    transition:
      transform 0.25s cubic-bezier(0.34, 1.4, 0.64, 1),
      border-color 0.2s,
      box-shadow 0.25s;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn.solid {
    border-color: transparent;
    color: var(--secondary-bg-color);
    background: var(--primary-text-color);
  }

  .btn.solid:hover {
    box-shadow: 0 12px 28px -14px rgb(0 0 0 / 0.7);
  }

  .btn.ghost:hover {
    border-color: color-mix(in srgb, var(--primary-text-color) 45%, transparent);
  }

  .btn .icon {
    transition: transform 0.25s;
  }

  .btn:hover .icon {
    transform: translateX(3px);
  }

  .card {
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--card);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .tags li {
    padding: 5px 11px;
    border-radius: 999px;
    font: 12.5px var(--font-mono);
    color: var(--blend-3-theme-color);
    background: rgb(65 160 174 / 0.12);
  }

  /* fade in on scroll (only with JavaScript, so content never stays hidden) */
  .js [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.7s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: var(--d, 0s);
  }

  .js [data-reveal].in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .js [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .caret {
      animation: none;
    }
  }

  @media (max-width: 760px) {
    .section {
      padding: 90px 0;
    }

    .band {
      padding: 120px 0;
    }
  }
</style>
